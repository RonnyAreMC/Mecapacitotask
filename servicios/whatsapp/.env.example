# Pasarela de WhatsApp (Baileys) del panel. Copia este archivo a .env y pon un token largo y al azar
# (openssl rand -hex 32). El mismo token va en el panel: Ajustes → Reuniones → WhatsApp.
BAILEYS_TOKEN=
# Fuera de cPanel escucha aquí. En cPanel no importa: Passenger pone su propio puerto.
BAILEYS_HOST=127.0.0.1
BAILEYS_PUERTO=3101
# Si la app queda en una subcarpeta del dominio (p. ej. /whatsapp), ponla aquí. Con un subdominio, vacío.
BAILEYS_BASE=
# Cómo aparece en el teléfono, en «Dispositivos vinculados».
BAILEYS_NOMBRE=InnoTech Hub
# Carpeta de la sesión de WhatsApp. Quien la tenga puede enviar como ese número: nunca a git ni a la web.
BAILEYS_DATOS=sesiones
# Milisegundos entre un mensaje y otro (cuida el número de bloqueos).
BAILEYS_ESPERA_MS=3000
# Registro interno de Baileys: silent, error, warn, info.
BAILEYS_LOG=silent
