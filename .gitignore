# Datos de runtime del panel (se generan al usarlo; no publicar datos del equipo)
admin/data/*.json
admin/data/*.json.importado
admin/data/.seeded
# La semilla del equipo lleva nombres y correos reales: se queda fuera del repo
admin/data/*.csv
# Cualquier respaldo o copia de la config: lleva credenciales en texto plano
admin/data/config.json.*
# Lo que descarga Ajustes → Exportar configuración (mismas claves en texto plano)
*-config-*.json
*-credenciales-*.json
# Llave que cifra las claves de la IA (data/ia.json): nunca al repo
admin/data/ia.secreto
# Llave que cifra las contraseñas del correo InnoTech: nunca al repo
admin/data/correo.secreto
# Notificaciones nativas: claves del panel (push.json va por *.json) y archivos de trabajo del cron
admin/data/openssl-min.cnf
admin/data/cron_correo.lock
admin/data/*.bak
admin/uploads/*

# Base de datos SQLite y sus archivos temporales (WAL)
admin/data/*.sqlite
admin/data/*.sqlite-wal
admin/data/*.sqlite-shm

# Sesiones (se guardan aquí para que no se pierdan en cada deploy)
admin/data/sessions/

# Mantener las carpetas en el repo
!admin/data/.gitkeep
!admin/uploads/.gitkeep
# El candado de la carpeta de subidas sí se publica (si no, no llega al servidor)
!admin/uploads/.htaccess

# Sistema
.DS_Store
admin/data/notif_poda.txt
